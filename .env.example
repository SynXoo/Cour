# Copy to .env for local overrides. Every variable has a dev-friendly default
# baked into the code; you only need this file to override something.

# ── Runtime ────────────────────────────────────────────────────────────────
COUR_ENV=dev                # dev | test | prod
PORT=8080
LOG_LEVEL=info              # debug | info | warn | error

# ── Data stores (ports match docker-compose.yml host mappings) ─────────────
DATABASE_URL=postgres://cour:cour@localhost:5434/cour?sslmode=disable
REDIS_ADDR=localhost:6380

# ── Behavior ───────────────────────────────────────────────────────────────
AUTO_MIGRATE=true           # run pending migrations on API start (dev convenience)
DEMO_MODE=false             # true = never call AniList; serve committed fixtures only
WEB_ORIGIN=http://localhost:3000

# ── Auth (slice 2+) ────────────────────────────────────────────────────────
# 32-byte ed25519 seed, base64. Empty in dev = ephemeral key generated at boot
# (sessions won't survive restarts — fine for dev, never for prod).
AUTH_TOKEN_SEED=
# Discord OAuth is optional: leave blank and the "Sign in with Discord"
# button hides itself.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Email (dev default writes .emails/*.txt instead of sending) ────────────
EMAIL_MODE=log              # log | smtp

# ── Trending algorithm (documented in docs/ALGORITHMS.md) ─────────────────
# score(a) = Σ_events weight(type) · 2^(−age/half_life) + blend · upstream_norm · 20
#TRENDING_HALF_LIFE=96h
#TRENDING_WINDOW=336h
#TRENDING_BLEND=0.15
#TRENDING_WEIGHT_review=3.0
#TRENDING_WEIGHT_favorite=2.5
#TRENDING_WEIGHT_comment=1.5
#TRENDING_WEIGHT_completed=1.2
#TRENDING_WEIGHT_list_add=1.0
#TRENDING_WEIGHT_scored=0.8
#TRENDING_WEIGHT_status_change=0.5
#TRENDING_WEIGHT_helpful_vote=0.5
#TRENDING_WEIGHT_progress=0.3
